---
import Button from '../ui/Button.astro'
import type { GalleryImage } from '../../lib/resourcepack-data'
interface Props {
  title: string
  images: GalleryImage[]
}
const { title, images } = Astro.props
const authorCount = images.filter((image) => image.origin !== 'local').length
const groups = [
  {
    name: 'Author gallery',
    images: images.filter((image) => image.origin !== 'local'),
  },
  {
    name: 'Create Sky tests',
    images: images.filter((image) => image.origin === 'local'),
  },
].filter((group) => group.images.length)
const credit = (image: GalleryImage) =>
  image.credit || `${authorCount} images · not a Create Sky test`
---

<section class="pack-gallery" aria-label={`${title} gallery`} data-gallery>
  <figure>
    <a
      class="gallery-open"
      href={images[0].url}
      data-open-image
      aria-label={`Enlarge ${title} image`}
    >
      <img
        class="gallery-main"
        src={images[0].url}
        alt={images[0].caption}
        loading="lazy"
        decoding="async"
      />
    </a>
    <video
      class="gallery-video"
      controls
      playsinline
      preload="none"
      hidden
      aria-label={`${title} test recording`}
    ></video>
    <Button type="button" data-open-video hidden>
      Enlarge recording
    </Button>
    <figcaption>
      <span data-caption>{images[0].caption}</span>
      <span data-image-error hidden>
        Media unavailable. Open the source below.
      </span>
    </figcaption>
  </figure>
  {groups.map((group) => (
    <div class="gallery-group" role="group" aria-label={group.name}>
      {(groups.length > 1 || group.name === 'Create Sky tests') && (
        <p class="gallery-group-title">{group.name}</p>
      )}
      <div class="gallery-thumbnails" aria-label="Choose an image or recording">
        {group.images.map((image) => (
          <Button
            type="button"
            data-image={image.url}
            data-caption={image.caption}
            data-kind={image.kind || 'image'}
            data-source={image.source}
            data-origin={image.origin || 'author'}
            data-credit={credit(image)}
            aria-label={`${title}, ${image.kind === 'video' ? 'recording' : 'image'} ${images.indexOf(image) + 1}: ${image.caption}`}
            aria-pressed={image === images[0]}
          >
            {image.kind === 'video' ? (
              <span class="gallery-clip-label">Clip</span>
            ) : (
              <img
                src={image.thumbnail}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
          </Button>
        ))}
      </div>
    </div>
  ))}
  <p class="gallery-credit">
    <a
      data-gallery-source
      href={images[0].source}
      target="_blank"
      rel="noreferrer"
    >
      {images[0].origin === 'local'
        ? 'Open original capture'
        : 'Author’s source gallery'}
    </a>
    {' · '}
    <span data-gallery-credit>{credit(images[0])}</span>
  </p>
</section>
