---
import Gallery from './Gallery.astro'
import { projects, statuses, type Review } from '../../lib/resourcepack-data'
interface Props {
  review: Review
}
const { review } = Astro.props
const project = projects[review.id]
const evidence = project.inspection
const searchable = [
  project.title,
  review.category,
  review.description,
  review.fit,
  review.concern,
  review.nextCheck,
  ...project.links.map((l) => l.label),
]
  .join(' ')
  .toLowerCase()
---

<article
  id={review.id}
  class="resource-candidate"
  data-candidate
  data-status={review.status}
  data-category={review.category}
  data-search={searchable}
>
  <div class="candidate-copy">
    <div class="candidate-meta">
      <span class="review-status" data-state={review.status}>
        {statuses[review.status]}
      </span>
      <span>{review.category}</span>
    </div>
    <h2>
      <a href={`#${review.id}`}>{project.title}</a>
    </h2>
    <p class="candidate-description">{review.description}</p>
    <p>{review.fit}</p>
    <p class="candidate-concern">{review.concern}</p>
    <p>
      <b>Check next:</b> {review.nextCheck}
    </p>
    <ul class="candidate-links" aria-label={`${project.title} sources`}>
      {project.links.map((link) => (
        <li>
          <a href={link.url} target="_blank" rel="noreferrer">
            {link.label} ↗
          </a>
        </li>
      ))}
    </ul>
    <details class="candidate-evidence">
      <summary>
        File evidence
        {evidence
          ? ` · ${evidence.effectiveAssetCount.toLocaleString()} effective assets`
          : ' · source review only'}
      </summary>
      {evidence ? (
        <>
          <p>
            <a
              href={`https://modrinth.com/version/${evidence.version.id}`}
              target="_blank"
              rel="noreferrer"
            >
              {evidence.version.name}
            </a>{' '}
            · {evidence.version.version_type}
          </p>
          <p class="file-name">{evidence.file.filename}</p>
          <p>
            Listed for 1.21.1.{' '}
            {evidence.declaresTargetFormat
              ? 'Metadata includes resource format 34.'
              : `Metadata does not declare a valid range containing format 34 (base format ${evidence.format}).`}
          </p>
          {evidence.metadataWarning && <p>{evidence.metadataWarning}.</p>}
          {evidence.fusionMinimum && (
            <p>
              Fusion ≥ {evidence.fusionMinimum}; Fusion overrides{' '}
              {evidence.fusionOverridesIncluded ? 'included' : 'excluded'} in
              this inspection.
            </p>
          )}
          <p>
            {evidence.matchingInstalledAssets.toLocaleString()} paths match
            vanilla or installed mod resources. Matching mod namespaces:{' '}
            {evidence.matchingModNamespaces.join(', ') || 'none'}. This is a
            footprint check, not complete mod coverage.
          </p>
          {evidence.features.length > 0 && (
            <p>Detected features: {evidence.features.join(', ')}.</p>
          )}
          {Object.keys(evidence.overlaps).length > 0 ? (
            <>
              <p>
                Different bytes at paths also used by the inspected 0.1.9
                baseline:
              </p>
              <ul>
                {Object.entries(evidence.overlaps).map(([id, overlap]) => (
                  <li>
                    <a href={`#${id}`}>{projects[id]?.title || id}</a>:{' '}
                    {overlap.count} paths
                    <details>
                      <summary>Examples</summary>
                      <ul class="path-list">
                        {overlap.examples.map((path) => (
                          <li>{path}</li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ))}
              </ul>
              <p>
                Models and textures can replace one another. Language keys and
                font providers can merge; shared paths alone do not prove a
                conflict.
              </p>
            </>
          ) : (
            <p>
              No differing asset paths shared with the six resource packs in the
              inspected 0.1.9 baseline.
            </p>
          )}
          <details>
            <summary>SHA-512</summary>
            <code class="digest">{evidence.sha512}</code>
          </details>
        </>
      ) : (
        <p>
          {project.fileNote}{' '}
          <a href={project.versionUrl} target="_blank" rel="noreferrer">
            Listed download
          </a>
        </p>
      )}
    </details>
  </div>
  <Gallery title={project.title} images={project.gallery} />
</article>
