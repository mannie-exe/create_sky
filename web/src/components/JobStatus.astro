<details id="job-status" class="job-status" hidden>
  <summary id="job-summary" aria-live="polite">
    Authoring job
  </summary>
  <p id="job-message"></p>
  <pre id="job-diagnostic" hidden></pre>
  <button id="cancel-job" hidden>
    Cancel job
  </button>
</details>
<script>
  import { requestJSON } from '../lib/http'
  const panel = document.getElementById('job-status')!
  const summary = document.getElementById('job-summary')!
  const message = document.getElementById('job-message')!
  const diagnostic = document.getElementById('job-diagnostic')!
  const cancel = document.getElementById('cancel-job') as HTMLButtonElement
  let id = ''
  async function refresh() {
    try {
      const state = await requestJSON('/__atlas/jobs')
      const job = state.current || state.last
      if (job && job.name !== 'snapshot.fingerprint') {
        panel.hidden = false
        id = job.id
        const label = `${job.name}: ${job.state}`
        if (summary.textContent !== label) summary.textContent = label
        message.textContent =
          job.error ||
          (job.state === 'succeeded'
            ? 'Finished. Reload other open views if needed; instances were not changed.'
            : 'This operation uses saved source unless it is a preview.')
        diagnostic.textContent = job.diagnostic || ''
        diagnostic.hidden = !job.diagnostic
        cancel.hidden = !job.cancellable
      } else cancel.hidden = true
    } catch {
      /* Static previews have no local job endpoints. */
    }
  }
  cancel.addEventListener('click', async () => {
    cancel.disabled = true
    try {
      await requestJSON('/__atlas/jobs/cancel', { id })
      await refresh()
    } catch (error) {
      message.textContent = String(error)
    } finally {
      cancel.disabled = false
    }
  })
  if (import.meta.env.DEV) {
    void refresh()
    const timer = setInterval(() => {
      if (!document.hidden) void refresh()
    }, 1000)
    window.addEventListener('pagehide', () => clearInterval(timer), {
      once: true,
    })
  }
</script>
<style>
  .job-status {
    margin: 0 var(--page-gutter) 12px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--panel);
    font-size: 12px;
  }
  pre {
    max-height: 180px;
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
