---
import Field from '../ui/Field.astro'
import SourceEditor from '../ui/SourceEditor.astro'
import Button from '../ui/Button.astro'
import Workbench from '../ui/Workbench.astro'
---

<Workbench>
  <Fragment slot="browser">
    <Field id="model-search" label="Find model">
      <input id="model-search" type="search" />
    </Field>
    <div id="model-list" class="entry-list" aria-label="Model recipes"></div>
  </Fragment>
  <section id="model-editor" class="content-stack" hidden>
    <div class="control-row">
      <Field id="model-label" label="Label">
        <input id="model-label" />
      </Field>
      <label class="inline-field">
        <input id="model-enabled" type="checkbox" /> Include in generated pack
      </label>
    </div>
    <p id="model-output" class="model-path"></p>
    <fieldset id="extrusion-fields" hidden>
      <legend>Extrusion</legend>
      <div class="model-fields">
        <Field id="model-depth" label="Depth">
          <input
            id="model-depth"
            type="number"
            min="0.125"
            max="4"
            step="0.125"
          />
        </Field>
        <Field id="model-threshold" label="Alpha threshold">
          <input id="model-threshold" type="number" min="1" max="255" />
        </Field>
        <Field id="model-plane" label="Plane">
          <select id="model-plane"></select>
        </Field>
        <Field id="model-axis" label="Axis">
          <select id="model-axis">
            <option>x</option>
            <option>y</option>
            <option>z</option>
          </select>
        </Field>
        <Field id="model-center" label="Center">
          <input id="model-center" type="number" step="0.125" />
        </Field>
      </div>
      <div id="model-span" class="model-fields"></div>
    </fieldset>
    <fieldset id="fitting-fields" hidden>
      <legend>Model fitting</legend>
      <div class="model-fields">
        <Field id="model-element" label="Element">
          <select id="model-element"></select>
        </Field>
        <Field id="model-face" label="Face">
          <select id="model-face"></select>
        </Field>
        <Field id="model-rotation" label="UV rotation">
          <select id="model-rotation">
            <option>0</option>
            <option>90</option>
            <option>180</option>
            <option>270</option>
          </select>
        </Field>
      </div>
      <div id="model-bounds" class="model-fields"></div>
      <Button intent="destructive" id="model-reset-element">
        Reset element
      </Button>
    </fieldset>
    <div class="model-previews">
      <section class="content-stack">
        <header class="section-heading">
          <h2>Texture region</h2>
        </header>
        <div id="model-uv" class="model-fields"></div>
        <canvas
          id="model-texture"
          width="256"
          height="256"
          aria-label="Texture UV selection"
        ></canvas>
        <p class="scope">
          Drag a region or enter UV coordinates. The texture view shows the
          first frame.
        </p>
      </section>
      <section class="content-stack">
        <div class="section-heading">
          <h2>Model</h2>
          <Button id="model-camera">Reset view</Button>
          <label class="inline-field">
            <input id="model-wire" type="checkbox" /> Wireframe
          </label>
        </div>
        <canvas
          id="model-canvas"
          aria-label="Interactive model preview"
        ></canvas>
        <p id="model-statistics" class="scope"></p>
        <p class="scope">
          Drag to orbit; scroll to zoom. Game lighting, shaders, and moving
          contraptions require an in-game check.
        </p>
      </section>
    </div>
    <details>
      <summary>Recipe JSON</summary>
      <SourceEditor
        id="model-json"
        label="Selected recipe"
        rows={18}
        aria-describedby="models-status"
      >
        <Fragment slot="actions">
          <Button id="model-apply-json">Apply to draft</Button>
          <Button intent="destructive" id="model-discard-json" disabled>
            Discard JSON edits
          </Button>
        </Fragment>
      </SourceEditor>
    </details>
  </section>
</Workbench>
