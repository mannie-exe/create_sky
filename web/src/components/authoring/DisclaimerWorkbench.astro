---
import Workbench from './Workbench.astro'
---

<section id="disclaimers-panel" hidden>
  <Workbench>
    <Fragment slot="browser">
      <label>
        Find disclaimer
        <input
          id="disclaimer-search"
          type="search"
          placeholder="Key or message"
        />
      </label>
      <div class="actions">
        <button id="new-disclaimer">New disclaimer</button>
      </div>
      <nav id="disclaimers" class="entry-list" aria-label="Disclaimers"></nav>
      <p id="disclaimer-count" class="scope" role="status"></p>
    </Fragment>
    <h1>Disclaimer</h1>
    <p id="disclaimer-empty" hidden>
      No disclaimers. Create one to use in journal entries.
    </p>
    <div id="disclaimer-editor">
      <label>
        Key
        <input id="disclaimer-key" aria-describedby="disclaimer-key-help" />
      </label>
      <p id="disclaimer-key-help" class="scope">
        Lowercase letters, numbers and underscores. Existing keys are fixed.
      </p>
      <label>
        Message <textarea id="disclaimer-message" rows="5"></textarea>
      </label>
      <p id="disclaimer-error" class="field-error" role="status"></p>
      <p id="disclaimer-usage" class="scope"></p>
      <details>
        <summary>Journal entries using this message</summary>
        <ul id="disclaimer-references"></ul>
      </details>
      <button id="delete-disclaimer" aria-describedby="disclaimer-usage">
        Delete disclaimer
      </button>
      <h2>Text preview</h2>
      <p id="disclaimer-preview" class="message-preview"></p>
    </div>
  </Workbench>
</section>
