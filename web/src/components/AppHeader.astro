---
interface Props {
  label: string
}
const { label } = Astro.props
---

<header class="topbar">
  <a class="identity" href="/" aria-label="Create Sky atlas">
    <span class="mark">⌘</span>
    <span>
      CREATE <b>SKY</b>
      <small>PROGRESSION ATLAS / INTERNAL</small>
    </span>
  </a>
  <nav aria-label={label}>
    <slot />
  </nav>
  <slot name="status" />
</header>
