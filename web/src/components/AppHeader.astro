---
import JobStatus from './JobStatus.astro'
interface Props {
  page: 'atlas' | 'authoring' | 'resources'
}
const { page } = Astro.props
const pages = [
  { id: 'atlas', href: '/', label: 'Item map' },
  { id: 'authoring', href: '/authoring', label: 'Pack authoring' },
  { id: 'resources', href: '/resourcepacks', label: 'Resource packs' },
]
---

<header class="topbar">
  <a class="identity" href="/" aria-label="Create Sky atlas">
    <span class="mark">⌘</span>
    <span>
      CREATE <b>SKY</b>
      <small>Atlas</small>
    </span>
  </a>
  <nav aria-label="Atlas pages">
    {pages.map(({ id, href, label }) => (
      <a href={href} aria-current={page === id ? 'page' : undefined}>
        {label}
      </a>
    ))}
  </nav>
  <slot name="status" />
</header>

{import.meta.env.DEV && <JobStatus />}
