---
import ViewTabs from '../ViewTabs.astro'
import Minimap from './Minimap.astro'
---

<section id="graph-view" class="view" hidden>
  <ViewTabs label="Graph questions">
    <button data-graph="systems" aria-pressed="true">
      Systems
    </button>
    <button data-graph="processing" aria-pressed="false">
      Processing
    </button>
    <button data-graph="routes" aria-pressed="false">
      Item routes
    </button>
    <button data-graph="coverage" aria-pressed="false">
      Coverage
    </button>
  </ViewTabs>
  <div class="toolbar">
    <label id="graph-mod-control">
      System <select id="graph-mod" aria-label="Graph system"></select>
    </label>
    <label id="graph-status-control" hidden>
      Coverage{' '}
      <select id="graph-status" aria-label="Graph coverage">
        <option value="unmapped">No acquisition adapter</option>
        <option value="blocked">Blocked dependencies</option>
        <option value="excluded">Internal / creative</option>
        <option value="unified">Unified variants</option>
        <option value="mapped">Mapped routes</option>
      </select>
    </label>
    <label id="graph-limit-control">
      Connections{' '}
      <select id="graph-limit">
        <option value="12">Top 12</option>
        <option value="24">Top 24</option>
        <option value="1000">All</option>
      </select>
    </label>
    <div class="graph-actions">
      <button id="graph-fit">Fit</button>
      <button id="graph-reset">Reset view</button>
      <button id="graph-in" aria-label="Zoom graph in">
        +
      </button>
      <button id="graph-out" aria-label="Zoom graph out">
        −
      </button>
      <button id="graph-reload">Reload data</button>
    </div>
  </div>
  <p id="graph-question" class="muted"></p>
  <div id="graph-route-controls" class="toolbar" hidden>
    <strong id="graph-item-title"></strong>
    <select id="graph-route-view" aria-label="Route view">
      <option value="single">Single route</option>
      <option value="path">Minimum-depth path</option>
    </select>
    <select id="graph-relation" aria-label="Route direction">
      <option value="acquisition">Acquisition</option>
      <option value="uses">Uses</option>
    </select>
    <select id="graph-recipe" aria-label="Displayed route"></select>
    <button id="graph-inspect">Item details</button>
  </div>
  <p id="graph-counts" class="muted" role="status">
    Loading graphs…
  </p>
  <div class="graph-workbench">
    <section class="panel graph-sidebar" aria-label="Graph items">
      <h2 id="graph-list-title">Items</h2>
      <input
        id="graph-search"
        type="search"
        placeholder="Find an item…"
        aria-label="Search graph items"
      />
      <p id="graph-list-count" class="muted"></p>
      <div id="graph-results" class="graph-results"></div>
      <button id="graph-more" hidden>
        Show more
      </button>
    </section>
    <div>
      <div class="graph-shell">
        <div
          id="graph-canvas"
          tabindex="0"
          role="region"
          aria-label="Graph. Drag to pan, wheel to zoom; arrow keys pan, plus and minus zoom, Home fits."
        ></div>
      </div>
      <div class="graph-navigation">
        <div class="graph-record-controls">
          <label>
            Inspect node{' '}
            <select id="graph-node" aria-label="Inspect graph node"></select>
          </label>
          <label>
            Inspect connection{' '}
            <select
              id="graph-edge"
              aria-label="Inspect graph connection"
            ></select>
          </label>
        </div>
        <Minimap
          id="graph-minimap"
          label="Graph minimap. Click or drag to navigate; arrow keys pan."
        />
      </div>
      <p id="graph-rendering" class="muted"></p>
      <section class="panel" aria-label="Graph selection">
        <h2 id="graph-selection-title">Selection</h2>
        <p id="graph-selection-summary">
          Select a node or connection for its records.
        </p>
        <div id="graph-route-list" class="graph-results"></div>
        <div id="graph-recipe-preview"></div>
        <details id="graph-record" hidden>
          <summary>Selection data</summary>
          <pre id="graph-selection-data"></pre>
        </details>
      </section>
    </div>
  </div>
</section>
<style>
  .graph-workbench {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 16px;
  }
  .graph-sidebar {
    align-self: start;
  }
  .graph-sidebar input {
    width: 100%;
  }
  .graph-shell {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    overflow: hidden;
    background: var(--panel);
  }
  #graph-canvas {
    height: max(440px, calc(100vh - 340px));
    overflow: hidden;
    touch-action: none;
  }
  .graph-navigation {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }
  .graph-record-controls {
    display: grid;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }
  .graph-record-controls label {
    display: grid;
    gap: 4px;
  }
  .graph-record-controls select {
    width: 100%;
    min-width: 0;
  }
  .graph-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-left: auto;
  }
  .graph-results {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-height: 430px;
    overflow: auto;
  }
  .graph-results :global(button) {
    display: flex;
    align-items: center;
    gap: 8px;
    text-align: left;
    font-size: 12px;
    overflow-wrap: anywhere;
  }
  .graph-results :global(img) {
    width: 26px;
    height: 26px;
    image-rendering: pixelated;
  }
  #graph-route-list {
    max-height: 240px;
  }
  #graph-recipe {
    flex: 1;
    min-width: 180px;
  }
  pre {
    max-height: 280px;
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  @media (max-width: 700px) {
    .graph-workbench {
      grid-template-columns: minmax(0, 1fr);
    }
    .graph-sidebar .graph-results {
      max-height: 150px;
    }
    #graph-canvas {
      height: 460px;
    }
  }
</style>
