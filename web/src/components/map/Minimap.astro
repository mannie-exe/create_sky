---
interface Props {
  id: string
  label: string
}
const { id, label } = Astro.props
---

<canvas
  id={id}
  class="minimap"
  width="220"
  height="150"
  tabindex="0"
  role="group"
  aria-label={label}
></canvas>
<style>
  .minimap {
    width: 140px;
    height: 96px;
    flex-shrink: 0;
    background: var(--surface-canvas);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-control);
    cursor: crosshair;
    touch-action: none;
  }
  .minimap:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
  }
</style>
